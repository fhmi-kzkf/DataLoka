# ==============================================================================
# DATALOKA - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Salin file ini menjadi `.env` atau `.env.local` untuk konfigurasi lokal:
#   cp .env.example .env.local
#
# JANGAN PERNAH menyimpan file `.env` atau `.env.local` yang berisi API key ke Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NVIDIA NIM INFERENCE API (Tanya Data AI Engine)
# ------------------------------------------------------------------------------
# Dapatkan API Key gratis / enterprise di: https://build.nvidia.com
# Format API Key: nvapi-...
# Catatan: Jika API key dikosongkan atau semua model gagal, sistem secara otomatis
# mengaktifkan fallback mesin NLP heuristik Bahasa Indonesia internal.
NVIDIA_NIM_API_KEY=

# Base URL untuk OpenAI-compatible NVIDIA NIM API endpoint
# Default: https://integrate.api.nvidia.com/v1
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Model LLM Utama (Primary Model)
# Contoh:
# - nvidia/nemotron-3.5-lightning-30b-a3b
# - meta/llama-3.1-70b-instruct
# - meta/llama-3.3-70b-instruct
# - mistralai/mixtral-8x22b-instruct
NVIDIA_NIM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Rantai Model Fallback (Dipisahkan koma, dieksekusi berurutan jika model utama gagal/timeout/429/404)
NVIDIA_NIM_FALLBACK_MODELS=meta/llama-3.1-70b-instruct,meta/llama-3.3-70b-instruct,mistralai/mixtral-8x22b-instruct

# ------------------------------------------------------------------------------
# 2. FIREBASE AUTHENTICATION & CLOUD STORAGE
# ------------------------------------------------------------------------------
# Dapatkan konfigurasi web app dari Firebase Console (https://console.firebase.google.com)
# Catatan: Jika variabel Firebase dikosongkan, DataLoka berjalan dalam mode
# Resilient Local Storage Fallback (simulasi auth & simpan lokal otomatis aktif).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ------------------------------------------------------------------------------
# 3. APPLICATION CONFIGURATION & PUBLIC URL
# ------------------------------------------------------------------------------
# URL publik aplikasi untuk pembentukan tautan berbagi (Shared Snapshot Link)
# Lokal: http://localhost:3000
# Produksi: https://dataloka.yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Nama identitas aplikasi
NEXT_PUBLIC_APP_NAME=DataLoka

# Mode lingkungan (development | production | test)
NODE_ENV=development

# ------------------------------------------------------------------------------
# 4. SYSTEM & TELEMETRY SETTINGS
# ------------------------------------------------------------------------------
# Matikan pengiriman telemetri Next.js (1 = nonaktif, 0 = aktif)
NEXT_TELEMETRY_DISABLED=1
